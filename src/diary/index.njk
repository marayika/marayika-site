---
permalink: /diary/
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Diary — Marayika</title>
<meta name="description" content="Poetry, essays and a gallery by Marayika.">
<meta property="og:title" content="Diary — Marayika">
<meta property="og:description" content="Poetry, essays and a gallery by Marayika.">
<meta property="og:image" content="https://marayika.com/images/ange.jpg">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&amp;family=Inter:wght@400;500&amp;family=Caveat:wght@500;700&amp;family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&amp;display=swap">
<style>
body{margin:0;background:#FBFAF6}
a{color:#141414}a:hover{color:#BA2924}
summary::-webkit-details-marker{display:none}
:focus-visible{outline:2.5px solid #BA2924;outline-offset:3px}
.lift{transition:transform .25s ease, box-shadow .25s ease}
.lift:hover{transform:rotate(0deg) translate(-3px,-4px) !important;box-shadow:9px 10px 0 #141414 !important}
.card{transition:transform .2s ease, box-shadow .2s ease}
.card:hover{transform:translate(-3px,-3px);box-shadow:5px 5px 0 #BA2924 !important}
@media (prefers-reduced-motion: reduce){.lift,.card{transition:none}}
@media (max-width: 640px){header,main,footer{padding-left:44px !important;padding-right:20px !important}}
</style>
</head>
<body>
<div style="position: relative; min-height: 100vh; color: #141414; font-family: Inter, system-ui, sans-serif; font-size: 17px; line-height: 1.6; background-color: #FBFAF6; background-image: linear-gradient(#E6E2D8 1px, transparent 1px), linear-gradient(90deg, #E6E2D8 1px, transparent 1px); background-size: 28px 28px; overflow: hidden">

<div aria-hidden="true" style="position: absolute; top: 0; bottom: 0; left: 28px; width: 2px; background: #BA2924; opacity: 0.55"></div>

<header style="max-width: 1180px; margin: 0 auto; padding: 28px 40px 0 56px; display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; align-items: center">
<a href="/" style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 26px; letter-spacing: -0.03em; text-decoration: none; padding: 6px 0">marayika<span style="color: #BA2924">.</span></a>
<details style="position: relative">
<summary aria-label="Menu" style="list-style: none; cursor: pointer; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border: 1.5px solid #141414; background: #FFFFFF; box-shadow: 3px 3px 0 #141414"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
<nav aria-label="Main" style="position: absolute; right: 0; top: calc(100% + 10px); z-index: 20; min-width: 240px; background: #FFFFFF; border: 1.5px solid #141414; box-shadow: 4px 4px 0 #141414; display: flex; flex-direction: column">
<a href="/portfolio/" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; text-decoration: none; border-bottom: 1px solid #141414; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: -0.01em">Portfolio</a>
<a href="/diary/" aria-current="page" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; text-decoration: none; border-bottom: 1px solid #141414; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: -0.01em">Diary<span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #BA2924"></span></a>
<a href="/soft-epilogue/" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; text-decoration: none; border-bottom: 1px solid #141414; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: -0.01em">Soft Epilogue</a>
<a href="/contact/" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 20px; text-decoration: none; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: 22px; letter-spacing: -0.01em">Contact</a>
</nav>
</details>
</header>

<main style="max-width: 1180px; margin: 0 auto; padding: 64px 40px 72px 56px; display: flex; flex-direction: column; gap: 72px">

<section style="display: flex; flex-direction: column; gap: 18px">
<p style="margin: 0; font-family: Caveat, cursive; font-weight: 700; font-size: 34px; color: #BA2924; transform: rotate(-2deg); transform-origin: left">a few pages from my diary&nbsp;—</p>
<h1 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(72px, 11vw, 150px); line-height: 0.88; letter-spacing: -0.05em">diary<span style="color: #BA2924">.</span></h1>
<p style="margin: 8px 0 0; max-width: 560px; font-family: 'Bricolage Grotesque', sans-serif; font-size: 26px; line-height: 1.28; letter-spacing: -0.01em">Poetry, essays, <span style="background: linear-gradient(transparent 62%, #F4CFC9 62%); white-space: nowrap">images and memory.</span></p>
<div style="display: flex; flex-wrap: wrap; gap: 10px; padding-top: 6px"><button type="button" class="chip" data-filter="all" aria-pressed="true" style="border: 1.5px solid #141414; border-radius: 999px; padding: 8px 18px; font: inherit; font-size: 14px; cursor: pointer; background: #141414; color: #FBFAF6">All</button><button type="button" class="chip" data-filter="Poetry" aria-pressed="false" style="border: 1.5px solid #141414; border-radius: 999px; padding: 8px 18px; font: inherit; font-size: 14px; cursor: pointer; background: #FFFFFF; color: #141414">Poetry</button><button type="button" class="chip" data-filter="Essay" aria-pressed="false" style="border: 1.5px solid #141414; border-radius: 999px; padding: 8px 18px; font: inherit; font-size: 14px; cursor: pointer; background: #FFFFFF; color: #141414">Essays</button><button type="button" class="chip" data-filter="Gallery" aria-pressed="false" style="border: 1.5px solid #141414; border-radius: 999px; padding: 8px 18px; font: inherit; font-size: 14px; cursor: pointer; background: #FFFFFF; color: #141414">Gallery</button></div>
</section>

<section aria-label="Featured pieces" style="display: flex; flex-direction: column; border-top: 2px solid #141414">
{% for post in collections.diary | reverse %}
{% if post.data.images and post.data.images.length %}<div data-category="{{ post.data.category }}" class="entry" style="display: flex; flex-direction: {{ 'row' if loop.index is odd else 'row-reverse' }}; flex-wrap: wrap; align-items: center; gap: 28px 56px; padding: 48px 0; border-bottom: 1px dashed #9A958C; color: #141414">
<figure class="lift" style="margin: 0; flex: 1 1 340px; max-width: 540px; min-width: 0; position: relative; background: #FFFFFF; padding: 12px 12px 14px; border: 1.5px solid #141414; box-shadow: 5px 5px 0 #141414; transform: rotate({{ '-1.2' if loop.index is odd else '1.4' }}deg)">
<div aria-hidden="true" style="position: absolute; top: -13px; left: 50%; margin-left: -48px; width: 96px; height: 26px; background: rgba(226, 214, 186, 0.85); transform: rotate(-3deg)"></div>
<div style="display: grid; grid-template-columns: repeat({{ post.data.images | length if post.data.images | length < 3 else 3 }}, minmax(0, 1fr)); gap: 8px">{% for im in post.data.images %}<img src="{{ im }}" alt="{{ post.data.cover_alt }}" style="display: block; width: 100%; height: auto">{% endfor %}</div>
<figcaption style="padding-top: 10px; font-family: Caveat, cursive; font-weight: 500; font-size: 22px; text-align: center">{{ post.data.note }}</figcaption>
</figure>
<div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
<p style="margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px"><span style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 18px; color: #BA2924">{{ '0' if loop.index < 10 }}{{ loop.index }}</span><span style="font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #5A564F">{{ post.data.category }}</span></p>
<h2 style="margin: 0; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: clamp(26px, 3vw, 36px); line-height: 1.1; letter-spacing: -0.02em">{{ post.data.title }}</h2>
{% if post.data.subtitle %}<p style="margin: 0; max-width: 520px; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 19px; line-height: 1.45; color: #3D3A35">{{ post.data.subtitle }}</p>{% endif %}
</div>
</div>{% else %}<a href="{{ post.data.link }}" data-category="{{ post.data.category }}" class="entry" style="display: flex; flex-direction: {{ 'row' if loop.index is odd else 'row-reverse' }}; flex-wrap: wrap; align-items: center; gap: 28px 56px; padding: 48px 0; border-bottom: 1px dashed #9A958C; text-decoration: none; color: #141414">
<div class="lift" style="flex: 1 1 340px; max-width: 540px; min-width: 0; position: relative; background: #FFFFFF; padding: 12px 12px 14px; border: 1.5px solid #141414; box-shadow: 5px 5px 0 #141414; transform: rotate({{ '-1.2' if loop.index is odd else '1.4' }}deg)">
<div aria-hidden="true" style="position: absolute; top: -13px; left: 50%; margin-left: -48px; width: 96px; height: 26px; background: rgba(226, 214, 186, 0.85); transform: rotate(-3deg)"></div>
{% if post.data.cover %}<img loading="lazy" decoding="async" src="{{ post.data.cover }}" alt="{{ post.data.cover_alt }}" style="display: block; width: 100%; height: auto">{% else %}<div style="aspect-ratio: 16 / 9; background: #F4CFC9; display: flex; align-items: flex-end; padding: 20px; box-sizing: border-box"><span style="font-family: Caveat, cursive; font-weight: 700; font-size: 34px; line-height: 1.05; color: #141414">{{ post.data.title }}</span></div>{% endif %}
</div>
<div style="flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
<p style="margin: 0; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px"><span style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 18px; color: #BA2924">{{ '0' if loop.index < 10 }}{{ loop.index }}</span><span style="font-family: Caveat, cursive; font-weight: 700; font-size: 26px; line-height: 1; color: #BA2924">{{ post.date | dayMonthYear }}</span><span style="font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: #5A564F">{{ post.data.category }}</span></p>
<h2 style="margin: 0; display: flex; gap: 14px; justify-content: space-between; align-items: flex-start; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 600; font-size: clamp(26px, 3vw, 36px); line-height: 1.1; letter-spacing: -0.02em">{{ post.data.title }}<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#BA2924" stroke-width="1.6" stroke-linecap="round" aria-hidden="true" style="flex: none; margin-top: 6px"><path d="M6 18c3.8-4 7.6-8 11.6-11.8M9 6.4c2.9-.2 5.8-.3 8.6-.2.2 2.8.2 5.6 0 8.4"/></svg></h2>
{% if post.data.subtitle %}<p style="margin: 0; max-width: 520px; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 19px; line-height: 1.45; color: #3D3A35">{{ post.data.subtitle }}</p>{% endif %}
</div>
</a>{% endif %}
{% endfor %}
</section>
<p data-empty-note hidden style="margin: -40px 0 0; font-family: Caveat, cursive; font-weight: 700; font-size: 30px; color: #8A857C">nothing on this shelf yet — soon.</p>

<section aria-label="Get new pages by email" style="position: relative; margin-top: 24px; background-color: #FFFFFF; background-image: repeating-linear-gradient(transparent 0 31px, #EDE6D8 31px 32px); border: 1.5px solid #141414; box-shadow: 6px 6px 0 #141414; padding: 96px clamp(24px, 4vw, 48px) 40px; display: flex; flex-wrap: wrap; align-items: center; gap: 32px 56px">
<div aria-hidden="true" style="position: absolute; top: -22px; left: clamp(20px, 4vw, 48px); width: 78px; height: 94px; background: #FBFAF6; border: 2px dashed #BA2924; outline: 6px solid #FBFAF6; transform: rotate(-4deg); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px">
<img loading="lazy" decoding="async" src="/images/diary-logo.jpg" alt="" style="display: block; width: 62px; height: 62px; object-fit: cover">
<span style="font-family: Caveat, cursive; font-weight: 700; font-size: 15px; line-height: 1; color: #BA2924">Kigali</span>
</div>
<div style="flex: 1 1 300px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
<p style="margin: 0; font-family: Caveat, cursive; font-weight: 700; font-size: clamp(32px, 4vw, 42px); line-height: 1.05; color: #BA2924; transform: rotate(-2deg); transform-origin: left">get new pages by email&nbsp;—</p>
<p style="margin: 0; max-width: 420px; font-family: Newsreader, Georgia, serif; font-style: italic; font-size: 20px; line-height: 1.5; color: #3D3A35">When a new page is ready, it comes to you like a letter.</p>
</div>
<div style="flex: 1 1 320px; max-width: 460px; min-width: 0; background: #FFFFFF; border: 1.5px solid #141414">
<iframe src="https://marayika.substack.com/embed" title="Subscribe to Marayika’s Diary on Substack" width="100%" height="320" style="display: block; border: 0; background: #FFFFFF" frameborder="0" scrolling="no"></iframe>
</div>
</section>
</main>

<footer style="max-width: 1180px; margin: 0 auto; padding: 0 40px 40px 56px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 14px; color: #5A564F">
<p style="margin: 0">© 2026 marayika · Kigali, Rwanda</p>
<a href="/" style="color: #141414">← Back to home</a>
</footer>
</div>

<style>
.js-reveal main > section{opacity:0;transform:translateY(14px);transition:opacity .6s ease, transform .6s ease}
.js-reveal main > section.in{opacity:1;transform:none}
</style>
<script>
(function(){
  if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  document.documentElement.classList.add('js-reveal');
  var io = new IntersectionObserver(function(es){ es.forEach(function(e){ if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } }); }, {rootMargin: '0px 0px -8% 0px'});
  document.querySelectorAll('main > section').forEach(function(s, i){ if (i === 0) s.classList.add('in'); else io.observe(s); });
})();
</script>
<script>
document.querySelectorAll('.chip').forEach(function(c){c.addEventListener('click',function(){
var f=c.getAttribute('data-filter');
document.querySelectorAll('.chip').forEach(function(o){var on=o===c;o.setAttribute('aria-pressed',on);o.style.background=on?'#141414':'#FFFFFF';o.style.color=on?'#FBFAF6':'#141414';});
var n=0;document.querySelectorAll('.entry').forEach(function(e){var on=(f==='all'||e.getAttribute('data-category')===f);e.style.display=on?'':'none';if(on)n++;});var note=document.querySelector('[data-empty-note]');if(note)note.hidden=n>0;
});});
</script>
</body>
</html>
